{
  "$schema": "../gen/schemas/remote-schema.json",
  "identifier": "remote-pages",
  "description": "Allow remote pages to use page commands and the Oneko shortcut.",
  "windows": ["main", "private-*", "window-*"],
  "remote": {
    "urls": ["http://*", "https://*"]
  },
  "permissions": [
    "allow-toggle-page-devtools",
    "allow-open-page-print-dialog",
    "allow-open-find-bar",
    "allow-open-reopen-closed-tab",
    "allow-oneko-settings-get",
    "allow-oneko-toggle"
  ]
}
